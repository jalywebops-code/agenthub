<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hermes dashboard for AgentHub's Hermes lane, on this computer only (127.0.0.1:__PORT__). Installed by
     `npm run install-service` when Hermes is on. Hermes's own dashboard service (which listens on every address) is
     left alone. A clean stop (hermes dashboard --stop) is not restarted; only crashes are. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.hermes/hermes-agent/venv/bin/python</string>
    <string>-m</string>
    <string>hermes_cli.main</string>
    <string>dashboard</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>__PORT__</string>
    <string>--no-open</string>
    <string>--skip-build</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__/.hermes/hermes-agent</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HERMES_HOME</key>
    <string>__HOME__/.hermes</string>
    <key>HERMES_WEB_DIST</key>
    <string>__HOME__/.hermes/hermes-agent/hermes_cli/web_dist</string>
    <key>VIRTUAL_ENV</key>
    <string>__HOME__/.hermes/hermes-agent/venv</string>
    <key>PATH</key>
    <string>__HOME__/.hermes/hermes-agent/venv/bin:__HOME__/.hermes/node/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:__HOME__/.hermes/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__ROOT__/logs/hermes-dashboard.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/logs/hermes-dashboard.log</string>
</dict>
</plist>
